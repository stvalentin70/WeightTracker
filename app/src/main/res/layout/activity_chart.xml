<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_large"
    android:background="@color/background_light"
    tools:context=".ChartActivity">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/chartTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chart_title"
        android:textSize="@dimen/text_size_xxxlarge"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/padding_large"/>

    <!-- Панель управления -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/chart_card_corner_radius"
        app:cardElevation="@dimen/elevation_low"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="@dimen/padding_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/chart_card_padding">

            <!-- Выбор периода -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/control_spacing">

                <ImageView
                    android:layout_width="@dimen/chart_icon_size"
                    android:layout_height="@dimen/chart_icon_size"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/primary_blue"
                    android:layout_marginEnd="@dimen/padding_medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_label"
                    android:textSize="@dimen/text_size_large"
                    android:textColor="@color/text_primary"
                    android:layout_marginEnd="@dimen/spacing_medium"/>

                <Spinner
                    android:id="@+id/periodSpinner"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/spinner_height"
                    android:layout_weight="1"
                    android:entries="@array/chart_periods"
                    android:padding="@dimen/spinner_padding"
                    android:background="@drawable/spinner_background"
                    android:textSize="@dimen/spinner_text_size"/>

            </LinearLayout>

            <!-- Подсказка -->
            <LinearLayout
                android:id="@+id/hintContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/primary_blue_light"
                android:padding="@dimen/padding_medium"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:src="@drawable/ic_info"
                    android:tint="@color/primary_blue"
                    android:layout_marginEnd="@dimen/padding_medium"/>

                <TextView
                    android:id="@+id/hintTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_hint_tap_point"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/primary_blue"
                    android:maxWidth="280dp"
                    android:ellipsize="end"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- График -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/padding_large"
        app:cardCornerRadius="@dimen/chart_card_corner_radius"
        app:cardElevation="@dimen/chart_card_elevation"
        app:cardBackgroundColor="@color/white">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/padding_medium">

            <com.stvalentin.weighttracker.SimpleLineChartView
                android:id="@+id/simpleLineChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/padding_large"/>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- Статистика -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/chart_card_corner_radius"
        app:cardElevation="@dimen/elevation_low"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/chart_card_padding">

            <TextView
                android:id="@+id/averageWeightTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Средний вес: --"
                android:textSize="@dimen/chart_stats_text_size"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Состояние "нет данных" -->
    <androidx.cardview.widget.CardView
        android:id="@+id/emptyStateCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/chart_card_corner_radius"
        app:cardElevation="@dimen/elevation_low"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/padding_xlarge">

            <ImageView
                android:layout_width="@dimen/chart_empty_icon_size"
                android:layout_height="@dimen/chart_empty_icon_size"
                android:src="@drawable/ic_chart_empty"
                android:tint="@color/primary_gray"
                android:layout_marginBottom="@dimen/padding_large"/>

            <TextView
                android:id="@+id/emptyStateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_state_loading"
                android:textSize="@dimen/chart_empty_text_size"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>