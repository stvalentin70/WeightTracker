<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <!-- Заголовок с именем пользователя -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/elevation_low"
            android:layout_marginBottom="@dimen/spacing_large"
            android:backgroundTint="@color/primary_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:gravity="center">

                <TextView
                    android:id="@+id/userNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_message"
                    android:textSize="@dimen/text_size_xlarge"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="@dimen/spacing_xsmall"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_message"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/primary_blue_light"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Карточка с текущим весом -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/elevation_low">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_weight"
                    android:textSize="@dimen/card_title_text_size"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <TextView
                    android:id="@+id/weightTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- кг"
                    android:textSize="@dimen/card_value_text_size"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Три карточки в строке: ИМТ, Прогресс, Калории -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_large">

            <!-- Карточка ИМТ -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_low"
                android:layout_marginEnd="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bmi_title"
                        android:textSize="@dimen/card_title_text_size"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <TextView
                        android:id="@+id/bmiTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="@dimen/card_value_text_size"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="@dimen/spacing_xsmall"/>

                    <TextView
                        android:id="@+id/bmiCategoryTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Введите данные"
                        android:textSize="@dimen/card_detail_text_size"
                        android:textColor="@color/text_secondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:gravity="center"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Карточка прогресса -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_low"
                android:layout_marginHorizontal="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_title"
                        android:textSize="@dimen/card_title_text_size"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/progress_bar_height_small"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/primary_green"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <TextView
                        android:id="@+id/progressTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Установите цель"
                        android:textSize="@dimen/card_detail_text_size"
                        android:textColor="@color/text_secondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:gravity="center"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Карточка калорий -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_low"
                android:layout_marginStart="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calories_title"
                        android:textSize="@dimen/card_title_text_size"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <TextView
                        android:id="@+id/caloriesTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="@dimen/card_value_text_size"
                        android:textColor="@color/primary_orange"
                        android:layout_marginBottom="@dimen/spacing_xsmall"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_kcal"
                        android:textSize="@dimen/card_detail_text_size"
                        android:textColor="@color/text_hint"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Шкала ИМТ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/elevation_low"
            android:layout_marginBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Шкала ИМТ"
                    android:textSize="@dimen/card_title_text_size"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_medium"/>

                <!-- Контейнер для шкалы ИМТ с индикатором -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <!-- Градиентная шкала ИМТ -->
                    <LinearLayout
                        android:id="@+id/bmiScaleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/bmi_scale_height"
                        android:orientation="horizontal"
                        android:background="@drawable/bmi_scale_gradient"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <!-- Индикатор текущего ИМТ -->
                    <View
                        android:id="@+id/bmiIndicator"
                        android:layout_width="@dimen/bmi_indicator_width"
                        android:layout_height="@dimen/bmi_indicator_height"
                        android:background="@color/indicator_current"
                        android:layout_marginTop="-2dp"
                        android:visibility="gone"/>

                </RelativeLayout>

                <!-- Подписи под шкалой -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="16"
                        android:textSize="@dimen/bmi_label_text_size"
                        android:textColor="@color/text_secondary"
                        android:gravity="start"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="18.5"
                        android:textSize="@dimen/bmi_label_text_size"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="25"
                        android:textSize="@dimen/bmi_label_text_size"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="30"
                        android:textSize="@dimen/bmi_label_text_size"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="35"
                        android:textSize="@dimen/bmi_label_text_size"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="40"
                        android:textSize="@dimen/bmi_label_text_size"
                        android:textColor="@color/text_secondary"
                        android:gravity="end"/>

                </LinearLayout>

                <!-- Легенда категорий -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Категории ИМТ:"
                        android:textSize="@dimen/card_small_text_size"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <!-- Первая строка легенды -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_xsmall">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@color/bmi_scale_severe"
                            android:layout_marginEnd="6dp"
                            android:layout_gravity="center_vertical"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="&lt;16: Выраженный дефицит"
                            android:textSize="@dimen/bmi_legend_text_size"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="8dp"/>

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@color/bmi_scale_thin"
                            android:layout_marginEnd="6dp"
                            android:layout_gravity="center_vertical"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="16-18.5: Дефицит"
                            android:textSize="@dimen/bmi_legend_text_size"
                            android:textColor="@color/text_secondary"/>

                    </LinearLayout>

                    <!-- Вторая строка легенды -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_xsmall">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@color/bmi_scale_normal"
                            android:layout_marginEnd="6dp"
                            android:layout_gravity="center_vertical"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="18.5-25: Норма"
                            android:textSize="@dimen/bmi_legend_text_size"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="8dp"/>

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@color/bmi_scale_overweight"
                            android:layout_marginEnd="6dp"
                            android:layout_gravity="center_vertical"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="25-30: Избыток"
                            android:textSize="@dimen/bmi_legend_text_size"
                            android:textColor="@color/text_secondary"/>

                    </LinearLayout>

                    <!-- Третья строка легенды -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@color/bmi_scale_obesity1"
                            android:layout_marginEnd="6dp"
                            android:layout_gravity="center_vertical"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="30-35: Ожирение I"
                            android:textSize="@dimen/bmi_legend_text_size"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="8dp"/>

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@color/bmi_scale_obesity2"
                            android:layout_marginEnd="6dp"
                            android:layout_gravity="center_vertical"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="35+: Ожирение II/III"
                            android:textSize="@dimen/bmi_legend_text_size"
                            android:textColor="@color/text_secondary"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Кнопки действий -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_large">

            <Button
                android:id="@+id/addButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_small"
                android:layout_weight="1"
                android:text="@string/add_weight"
                android:textSize="@dimen/card_small_text_size"
                android:layout_marginEnd="@dimen/spacing_small"
                android:backgroundTint="@color/primary_green"
                android:textColor="@color/text_white"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>

            <Button
                android:id="@+id/historyButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_small"
                android:layout_weight="1"
                android:text="@string/view_history"
                android:textSize="@dimen/card_small_text_size"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:backgroundTint="@color/primary_blue"
                android:textColor="@color/text_white"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>

            <Button
                android:id="@+id/chartButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_small"
                android:layout_weight="1"
                android:text="@string/view_chart"
                android:textSize="@dimen/card_small_text_size"
                android:layout_marginStart="@dimen/spacing_small"
                android:backgroundTint="@color/primary_orange"
                android:textColor="@color/text_white"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>

        </LinearLayout>

        <!-- Кнопка профиля -->
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/view_profile"
            android:textSize="@dimen/card_small_text_size"
            android:layout_marginBottom="@dimen/spacing_xlarge"
            android:backgroundTint="@color/primary_gray"
            android:textColor="@color/text_white"/>

        <!-- Версия приложения -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textSize="@dimen/text_size_xsmall"
            android:textColor="@color/text_hint"
            android:layout_gravity="center"/>

    </LinearLayout>

</ScrollView>